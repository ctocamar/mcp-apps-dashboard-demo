{
  "//": "Ejemplo de configuración para Claude Desktop. Copia el bloque mcpServers",
  "//_1": "en tu claude_desktop_config.json y ajusta la ruta --directory.",
  "//_2": "Ubicación del fichero real:",
  "//_windows": "%APPDATA%\\Claude\\claude_desktop_config.json",
  "//_macos": "~/Library/Application Support/Claude/claude_desktop_config.json",
  "mcpServers": {
    "panel-metricas": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\Git\\mcp-apps-test",
        "python",
        "server.py"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    }
  }
}
